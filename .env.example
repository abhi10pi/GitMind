# ── Copy this file to .env and fill in real values ───────────────────────────
# Windows: copy .env.example .env
# Mac/Linux: cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=gitmind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose: groq | openai
AI_PROVIDER=groq

# Groq — free chat
# Get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# OpenAI — optional, only needed when AI_PROVIDER=openai
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4o-mini

# Mistral — free embeddings
# Get free key at: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_EMBEDDING_MODEL=mistral-embed

# ── pgvector dimensions ───────────────────────────────────────────────────────
# mistral-embed → 1024 dims
PGVECTOR_DIMENSIONS=1024

# ── GitHub OAuth2 App ─────────────────────────────────────────────────────────
# Create one at https://github.com/settings/developers
# Callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ── Security ──────────────────────────────────────────────────────────────────
TOKEN_ENCRYPTOR_PASSWORD=gitmind-local-encrypt-key-change-me
TOKEN_ENCRYPTOR_SALT=deadbeefcafebabe
